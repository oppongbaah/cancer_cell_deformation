# Data, trained models and logs are NOT part of the repository (they are large, and the recordings
# are not ours to publish). They stay on the machines that made them; see "Data, models and logs"
# in README.md for how to request them. Anchored to the repository root, so the code in
# scripts/data/ and celldform/ is unaffected.
/data/
/checkpoints/
/logs/
/results/
*.pt
*.pth
*.ckpt
*.joblib
*.log

# Jupyter: scratch notebooks anywhere stay out, but notebooks/ is tracked (the runnable pipeline
# walkthrough). Strip outputs before committing.
.ipynb_checkpoints/
*.ipynb
!notebooks/**/*.ipynb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local only
supporting_docs/
CLAUDE.md
.claude
configs/notebook/

# demo-only classifier: keep the script, the .joblib and the LOOCV table; ignore the segmentations, features and logs
demo_classifier/data/
demo_classifier/results/
demo_classifier/logs/
demo_classifier/checkpoints/
